    m_Localized: HELICAL SPRING LABORATORY PRACTICE
    m_Metadata:
      m_Items: []
  - m_Id: 530216005632
    m_Localized: Welcome to the virtual reality physics laboratory practical environment!
      To perform the spring practical, please register.
    m_Metadata:
      m_Items: []
  - m_Id: 605474402304
    m_Localized: REGISTER
    m_Metadata:
      m_Items: []
  - m_Id: 982613551984640
    m_Localized: "Physics Laboratory \nHelical Spring"
    m_Metadata:
      m_Items: []
  - m_Id: 982640840126464
    m_Localized: The field must not contain special characters.
    m_Metadata:
      m_Items: []

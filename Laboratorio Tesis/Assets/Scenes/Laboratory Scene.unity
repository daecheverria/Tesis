  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Experimento 1: \n\nEl objetivo es medir cu\xE1nto tarda el resorte en
    completar 20 oscilaciones con cada masa.\n\n1.Agarra la primera pesa (ej. 5g)
    de la bandeja y col\xF3cala en el gancho del resorte.\n\n2.Deja que la pesa se
    estabilice (quede quieta) y mide con la regla la longitud que marca el resorte.\n\n3.Estira
    la pesa verticalmente una peque\xF1a distancia (1-2 cm) y su\xE9ltala con cuidado
    para que comience a oscilar.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: abc909e2766aaf5409b99a5a9b443e3a, type: 2}
  m_sharedMaterial: {fileID: -5932811503762062064, guid: abc909e2766aaf5409b99a5a9b443e3a, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
